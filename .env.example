# ─────────────────────────────────────────────────────────────
# Léman Poker & Casino — environment variables
# Copy to .env.local (development) or set them in your host (Vercel…).
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used in emails, sitemap, social metadata)
SITE_URL=https://www.example.ch

# PostgreSQL connection string (REQUIRED in production).
# Without it, a local embedded database is used in development (.data/pglite).
DATABASE_URL=postgres://user:password@host:5432/leman?sslmode=require
# DATABASE_POOL_MAX=5
# DATABASE_SSL=false            # set to "false" to disable TLS for a local Postgres

# Demo mode: the site seeds itself with fictitious tournaments, bookings, results and
# 3 demo accounts (password LemanDemo2026). On by default locally without DATABASE_URL.
# Set DEMO_MODE=true on Vercel for a client demo without Postgres (data per instance, in /tmp).
# DEMO_MODE=true

# Only for a single self-hosted server with persistent disk and no Postgres:
# ALLOW_EMBEDDED_DB=true
# PGLITE_DIR=/var/lib/leman/pglite

# Secret used to sign players' private "manage my booking" links (min. 32 random characters).
# Changing it invalidates links already sent by email.
APP_SECRET=change-me-to-at-least-32-random-characters

# ── Email (SMTP) ── without SMTP_HOST, no email is sent (bookings are still saved
# and the site clearly says that no email was sent).
SMTP_HOST=mail.example.ch
SMTP_PORT=587
SMTP_SECURE=false               # true for port 465
SMTP_USER=reservations@example.ch
SMTP_PASSWORD=change-me
SMTP_FROM=reservations@example.ch

# ── First owner account (optional web setup at /admin/setup) ──
# At least 16 random characters. Remove it once the owner account exists.
# ADMIN_SETUP_TOKEN=

# ── Scheduled reminders (/api/cron/reminders) ──
# At least 16 random characters. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=change-me-to-a-long-random-string
